import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";

// CHANGE 1: Rename the function from "middleware" to "proxy"
export function proxy(req: NextRequest) {
  console.log("PROXY RUNNING ✅");

  const pathname = req.nextUrl.pathname;

  const accessToken = req.cookies.get("access_token")?.value;
  const role = req.cookies.get("role")?.value; // ADMIN | USER

  // 🔒 Protect admin and user routes (must be logged in)
  if (pathname.startsWith("/admin") || pathname.startsWith("/user")) {
    if (!accessToken) {
      return NextResponse.redirect(new URL("/auth/login", req.url));
    }
  }

  // 🔐 Role-based protection

  // If trying to access admin but not ADMIN
  if (pathname.startsWith("/admin") && role !== "ADMIN") {
    return NextResponse.redirect(new URL("/user", req.url));
  }

  // If trying to access user but not USER
  if (pathname.startsWith("/user") && role !== "USER") {
    return NextResponse.redirect(new URL("/admin", req.url));
  }

  return NextResponse.next();
}

// CHANGE 2: This config stays EXACTLY the same
export const config = {
  matcher: ["/admin/:path*", "/user/:path*"],
};